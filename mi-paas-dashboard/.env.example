# Motor remoto opcional. Si no responde, el panel usa store local (file:./dev.db).
# API_URL=http://46.101.84.190
# API_URL=http://localhost:3000

# Store local (SQLite-file / JSON) para modo standalone sin Docker ni Postgres.
DATABASE_URL=file:./dev.db

# Requerido. Sin este valor el login rechaza todas las credenciales.
ADMIN_PASSWORD=change-me
# Opcional: firma de sesión (si no, se usa ADMIN_PASSWORD)
# NEXTAUTH_SECRET=
# Opcional: header x-api-key (si no, se usa ADMIN_PASSWORD)
# ADMIN_API_KEY=
