{
  "name": "paas-deploy-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/workers/deployWorker.ts",
    "build": "tsc && node --input-type=module -e \"import fs from 'node:fs'; fs.cpSync('src/generated', 'dist/generated', { recursive: true })\"",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.58.5",
    "dockerode": "^4.0.12",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "ioredis": "^5.8.0",
    "pg": "^8.23.1",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/dockerode": "^3.3.47",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
