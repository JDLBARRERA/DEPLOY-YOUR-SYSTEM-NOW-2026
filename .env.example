# Motor Fastify (producción / VPS). Para UI local sin Docker/Postgres:
# cd mi-paas-dashboard && npm run dev  (DATABASE_URL=file:./dev.db)
REDIS_URL=redis://127.0.0.1:6379
CADDY_ADMIN_URL=http://127.0.0.1:2019
DEPLOY_CONCURRENCY=2
PORT=3000
DATABASE_URL="postgresql://paas:paas@localhost:6543/paas?schema=public"
DB_CREDENTIALS_KEY=replace-with-64-hex-chars
PGBOUNCER_PASSWORD=pgbouncer
DEPLOY_NETWORK=paas
APP_DOMAIN=localhost
CORS_ORIGIN=http://localhost:3000
GITHUB_WEBHOOK_SECRET=replace-with-the-github-webhook-secret
GITHUB_PAT=
DEPLOY_MEMORY=512m
DEPLOY_CPUS=0.5
