{
  "admin": {
    "listen": "0.0.0.0:2019",
    "enforce_origin": false,
    "origins": ["http://127.0.0.1:2019", "http://localhost:2019"]
  },
  "apps": {
    "http": {
      "servers": {
        "paas": {
          "listen": [":80", ":443"],
          "routes": [
            {
              "@id": "route-catch-all",
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 404,
                  "body": "Not Found"
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    }
  }
}
