generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  member
}

enum DeploymentType {
  PRODUCTION
  PREVIEW
}

enum EnvScope {
  ALL
  PRODUCTION
  PREVIEW
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(member)
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  teams         Team[]
  apiKeys       ApiKey[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Team {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id])
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Project {
  id          String       @id @default(cuid())
  name        String
  repoUrl     String
  branch      String       @default("main")
  memoryLimit String       @default("256m")
  cpuLimit    Float        @default(0.5)
  githubToken String?
  teamId      String
  team        Team         @relation(fields: [teamId], references: [id])
  envVars     Json         @default("{}")
  createdAt   DateTime     @default(now())
  deployments Deployment[]
  env         EnvVar[]
  database    DatabaseInstance?
}

model EnvVar {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key         String
  value       String   @db.Text
  environment EnvScope @default(ALL)
  createdAt   DateTime @default(now())

  @@unique([projectId, key, environment])
}

model Deployment {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  status        String
  type          DeploymentType @default(PRODUCTION)
  containerId   String?
  port          Int?
  url           String?
  buildLogs     String?        @db.Text
  commitHash    String?
  commitMessage String?        @db.Text
  commitAuthor       String?
  commitAuthorAvatar String?
  branch             String?
  createdAt     DateTime       @default(now())
}

model DatabaseInstance {
  id         String   @id @default(uuid())
  name       String
  dbName     String   @unique
  dbUser     String   @unique
  dbPassword String
  host       String   @default("127.0.0.1")
  port       Int      @default(5432)
  pooledPort Int      @default(6543)
  projectId  String?  @unique
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parentId   String?
  parent     DatabaseInstance?  @relation("DatabaseBranch", fields: [parentId], references: [id], onDelete: SetNull)
  branches   DatabaseInstance[] @relation("DatabaseBranch")
  createdAt  DateTime @default(now())
}

model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
